# Server-side env vars. Copy this file to `.env` and fill in the
# values. The backend repo's .gitignore already excludes `.env`,
# `.env.local`, `.env.production`, etc.

# --- HTTP server -----------------------------------------------------------
# The backend listens on this port. Defaults to 4000 if unset.
# Note: your pos-billing-ui/.env currently has REACT_APP_API_BASE pointing
# at http://localhost:4001. Either set PORT=4001 here to match, or update
# the frontend's .env to http://localhost:4000.
PORT=4000

# --- CORS allowlist --------------------------------------------------------
# Comma-separated origins allowed to call the API. Defaults to
# http://localhost:3000 (CRA's dev server). For prod, set this to your
# Vercel frontend URL.
FRONTEND_ORIGIN=http://localhost:3000

# --- Runtime mode ----------------------------------------------------------
# Set to "production" in Render. Leave unset or "development" locally.
# NODE_ENV=development

# --- MySQL (Railway) -------------------------------------------------------
# Find these in Railway Dashboard → your MySQL service → Variables tab.
# Map: MYSQLHOST → DB_HOST, MYSQLPORT → DB_PORT, MYSQLUSER → DB_USER,
# MYSQLPASSWORD → DB_PASSWORD, MYSQLDATABASE → DB_NAME.
DB_HOST=containers-us-west-XXX.railway.app
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=railway

# --- Optional tuning -------------------------------------------------------
# Max connections in the pool. Default 10.
# DB_POOL_SIZE=10
